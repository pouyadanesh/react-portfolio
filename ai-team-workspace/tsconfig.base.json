{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@ai-team-workspace/source"],
    "paths": {
      "@ai-team-workspace/ui": ["./libs/ui/src/index.ts"],
      "@ai-team-workspace/types": ["./libs/types/src/index.ts"],
      "@ai-team-workspace/utils": ["./libs/utils/src/index.ts"],
      "@ai-team-workspace/api": ["./libs/api/src/index.ts"]
    }
  }
}
